name = "Golden Terraform Template"
description = "A generic, provider-agnostic infrastructure-as-code deployment template using Octopus's built-in Terraform steps. Runs a plan for review, gates on manual approval, then applies. Supports any Terraform provider — AWS, Azure, local, or custom. Cloud credentials are injected via worker IAM roles or project-level variables. Terraform state backend is configured in the package's backend.tf. Ideal for platform teams standardising infrastructure provisioning across environments and tenants."

parameter "parameter.worker.pool" {
    display_settings = {
        Octopus.ControlType = "WorkerPool"
    }
    help_text = "Worker pool where Terraform plan and apply run. The worker needs network access to download Terraform providers (or a local mirror configured in the package)."
    label = "Worker Pool"
}

parameter "parameter.terraform.git.url" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Url of Git Repo where the therefrom is"
    label = "Git Repository URL"
}

parameter "parameter.terraform.template.directory" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Directory path in Git Repository "
    label = "Terraform Template Directory"
}

parameter "parameter.terraform.custom.params" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "Terraform Paramaters "
}

parameter "parameter.external.feed" {
    display_settings = {
        Octopus.ControlType = "Feed"
    }
    help_text = ""
    label = "External Octopus Feed"
}

parameter "parameter.octopus.url" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = "Url of your Octopus Deploy server"
    label = "Octopus Deploy Url "
}

parameter "parameter.octopus.api.key" {
    display_settings = {
        Octopus.ControlType = "Sensitive"
    }
    help_text = "API Key for Octopus Deploy Server"
    label = "Octopus Deploy API Key"
}

step "apply-a-terraform-template" {
    name = "Apply a Terraform template"

    action {
        action_type = "Octopus.TerraformApply"
        properties = {
            Octopus.Action.GitRepository.Source = "External"
            Octopus.Action.GoogleCloud.ImpersonateServiceAccount = "False"
            Octopus.Action.GoogleCloud.UseVMServiceAccount = "True"
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptSource = "GitRepository"
            Octopus.Action.Terraform.AdditionalActionParams = "-var=\"octopus_address=#{parameter.octopus.url}\" -var=\"octopus_api_key=#{parameter.octopus.api.key}\" #{parameter.terraform.custom.params} "
            Octopus.Action.Terraform.AllowPluginDownloads = "True"
            Octopus.Action.Terraform.AzureAccount = "False"
            Octopus.Action.Terraform.FileSubstitution = "*.tfvars"
            Octopus.Action.Terraform.GoogleCloudAccount = "False"
            Octopus.Action.Terraform.ManagedAccount = "None"
            Octopus.Action.Terraform.PlanJsonOutput = "False"
            Octopus.Action.Terraform.RunAutomaticFileSubstitution = "True"
            Octopus.Action.Terraform.TemplateDirectory = "#{parameter.terraform.template.directory}"
        }
        worker_pool_variable = "#{parameter.worker.pool}"

        container {
            feed = "#{parameter.external.feed}"
            image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
        }

        git_dependencies {
            default_branch = "main"
            git_credential_id = "GitCredentialIds-1"
            git_credential_type = "Library"
            repository_uri = "#{parameter.terraform.git.url}"
        }
    }
}